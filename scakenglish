
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ruimte Arcade 🚀</title>
<style>
body {
  margin: 0;
  background: #080b25;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
header { padding: 25px 10px; }
h1 { color: #69f5ff; font-size: 38px; }
button {
  background: #793cff;
  color: white;
  border: 0;
  border-radius: 12px;
  padding: 14px 20px;
  margin: 8px;
  font-size: 17px;
  cursor: pointer;
}
canvas {
  display: block;
  width: min(94%, 600px);
  height: auto;
  margin: 20px auto;
  background: #020412;
  border: 2px solid #69f5ff;
  border-radius: 12px;
}
</style>
</head>
<body>
<header>
  <h1>🚀 Ruimte Arcade</h1>
  <p>Welkom in jouw ruimtewereld!</p>
</header>

<h2>Kies je spel</h2>
<button onclick="startGame()">👾 Space Shooter</button>
<p id="info">Klik op Space Shooter om te beginnen.</p>
<canvas id="spel" width="600" height="400"></canvas>
<div>
  <button onclick="move(-1)">⬅️ Links</button>
  <button onclick="shoot()">🔫 Schieten</button>
  <button onclick="move(1)">➡️ Rechts</button>
</div>

<script>
const canvas = document.getElementById("spel");
const ctx = canvas.getContext("2d");
let ship = 280, bullets = [], aliens = [];
let score = 0, active = false, last = 0;

function startGame() {
  ship = 280;
  bullets = [];
  aliens = [];
  score = 0;
  active = true;
  document.getElementById("info").textContent =
    "Score: 0 — Beweeg en schiet op de aliens!";
  for (let i = 0; i < 5; i++) {
    aliens.push({x: 50 + i * 110, y: 40 + Math.random()*150});
  }
  requestAnimationFrame(loop);
}

function move(dir) {
  ship = Math.max(15, Math.min(545, ship + dir * 25));
}

function shoot() {
  if (active) bullets.push({x: ship + 20, y: 340});
}

document.addEventListener("keydown", e => {
  if (e.key === "ArrowLeft") move(-1);
  if (e.key === "ArrowRight") move(1);
  if (e.code === "Space") {
    e.preventDefault();
    shoot();
  }
});

function loop(time) {
  if (!active) return;
  ctx.clearRect(0, 0, 600, 400);

  ctx.fillStyle = "white";
  for (let i = 0; i < 65; i++) {
    ctx.fillRect((i*83)%600, (i*47)%400, 2, 2);
  }

  ctx.font = "30px Arial";
  ctx.fillText("🚀", ship, 370);

  bullets.forEach(b => b.y -= 5);
  bullets = bullets.filter(b => b.y > 0);

  aliens.forEach(a => {
    a.y += Math.sin(time/400 + a.x) * 0.5 + 0.4;
    ctx.fillText("👾", a.x, a.y);
  });

  bullets.forEach(b => {
    aliens = aliens.filter(a => {
      if (Math.abs(b.x-a.x) < 28 && Math.abs(b.y-a.y) < 25) {
        score += 10;
        b.y = -20;
        return false;
      }
      return true;
    });
  });

  if (aliens.length === 0) {
    for (let i = 0; i < 5; i++) {
      aliens.push({x: 40 + i*115, y: 40 + Math.random()*120});
    }
  }

  ctx.fillStyle = "#69f5ff";
  ctx.fillText("Score: " + score, 15, 25);
  document.getElementById("info").textContent =
    "Score: " + score + " — Schiet alle aliens neer!";
  requestAnimationFrame(loop);
}
</script>
</body>
</html>
